# ============================================
# RevLoop AI — Environment Configuration
# Copy to .env and fill in your values
# ============================================

# --- PostgreSQL ---
DATABASE_URL="postgresql://revloop_user:revloop_local_pass@localhost:5432/revloop_db"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Razorpay (Test Mode / Sandbox) ---
RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXXXXX"
RAZORPAY_KEY_SECRET="XXXXXXXXXXXXXXXXXXXXXXXX"
RAZORPAY_WEBHOOK_SECRET="XXXXXXXXXXXXXXXXXXXXXXXX"

# --- Google AI Studio (Gemini 2.5 Flash — Free Tier: 15 RPM / 1M TPM) ---
GEMINI_API_KEY="XXXXXXXXXXXXXXXXXXXXXXXX"

# --- Groq Cloud (Llama 3.3 70B — Free Tier: 30 RPM) ---
GROQ_API_KEY="gsk_XXXXXXXXXXXXXXXXXXXXXXXX"

# --- Meta WhatsApp Cloud API (Sandbox — 1,000 conversations/month) ---
WHATSAPP_ACCESS_TOKEN="XXXXXXXXXXXXXXXXXXXXXXXX"
WHATSAPP_PHONE_NUMBER_ID="XXXXXXXXXXXXXXXX"
WHATSAPP_VERIFY_TOKEN="revloop_webhook_verify"

# --- LiveKit (Open-Source WebRTC — Self-Hosted Docker) ---
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

# --- Server ---
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
